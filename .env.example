# Server-side configuration. In production these live in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Public URL used to build invitation links (no trailing slash)
APP_BASE_URL=https://anvaya-two-gamma.vercel.app
NODE_ENV=production

# Supabase Postgres — Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
# postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# First admin (created on first request if no admin exists yet)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email — use ONE of:
# 1) Resend (needs a verified domain to email anyone other than your own Resend account address)
RESEND_API_KEY=
# 2) Any SMTP server, e.g. Gmail with an App Password (works without owning a domain)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Anvaya <you@example.com>"

# Optional
INVITE_TTL_HOURS=72
SESSION_TTL_HOURS=12

# Local development only (no Supabase needed): in-process Postgres + in-memory email capture
# DATABASE_URL=pglite://data/pg
# MAIL_TRANSPORT=memory
