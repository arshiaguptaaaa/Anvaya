{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/api/index"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/mentor",
      "destination": "/api/index"
    },
    {
      "source": "/mentor/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/student",
      "destination": "/api/index"
    },
    {
      "source": "/student/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/invite",
      "destination": "/api/index"
    },
    {
      "source": "/reset",
      "destination": "/api/index"
    },
    {
      "source": "/login",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{src,supabase}/**",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/run",
      "schedule": "30 0 * * *"
    }
  ],
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}