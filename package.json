{
  "name": "anvaya-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Anvaya public site + admin CRM + mentor dashboard",
  "main": "src/app.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:import-sqlite": "node scripts/migrate-sqlite-to-postgres.js",
    "create-admin": "node src/create-admin.js",
    "vercel-build": "node scripts/db-migrate.js --if-configured",
    "backup": "node scripts/backup.js",
    "backup:verify": "node scripts/restore-check.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@vercel/functions": "^3.10.1",
    "express": "^4.21.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}
